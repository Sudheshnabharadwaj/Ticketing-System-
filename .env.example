# ─── PostgreSQL ───────────────────────────────────────────
POSTGRES_USER=platform
POSTGRES_PASSWORD=platform_secret
POSTGRES_DB=platform_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://platform:platform_secret@postgres:5432/platform_db

# ─── Redis ────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ─── Keycloak ─────────────────────────────────────────────
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=platform
KEYCLOAK_CLIENT_ID=backend-api
KEYCLOAK_CLIENT_SECRET=change-me-in-production
KEYCLOAK_JWKS_URL=http://keycloak:8080/realms/platform/protocol/openid-connect/certs

# ─── MinIO / S3 ───────────────────────────────────────────
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=platform-files
S3_REGION=us-east-1

# ─── App ──────────────────────────────────────────────────
APP_ENV=development
APP_SECRET_KEY=change-me-in-production-32-chars!!
DEBUG=true
ALLOWED_ORIGINS=http://localhost:3000

# ─── Sentry ───────────────────────────────────────────────
SENTRY_DSN=

# ─── Frontend (Next.js public vars) ───────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8080
NEXT_PUBLIC_KEYCLOAK_REALM=platform
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=frontend-app
