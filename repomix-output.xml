    <Box sx={{ display: "flex", flexDirection: "column", height: "100%" }}>
      <Toolbar sx={{ px: 2 }}>
        <Typography variant="h6" fontWeight={800} color="primary">
          ⬡ Platform
        </Typography>
      </Toolbar>
      <Divider />

      <Box sx={{ flex: 1, overflow: "auto", pt: 1 }}>
        <NavList items={NAV_ITEMS} />
